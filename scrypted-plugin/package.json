{
   "name": "@nphil/kibble-scrypted",
   "version": "0.0.1",
   "description": "Scrypted mixin for the Kibble feeder camera: real on-device detection events as ObjectDetector, an optional ONNX/OpenVINO off-device re-check, and an ONVIF-style RTSP backchannel Intercom.",
   "author": "",
   "license": "ISC",
   "private": true,
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "build": "scrypted-webpack",
      "prepublishOnly": "NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "scrypted-webpack",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-readme": "scrypted-readme",
      "scrypted-package-json": "scrypted-package-json"
   },
   "keywords": [
      "scrypted",
      "plugin",
      "kibble",
      "camera",
      "intercom"
   ],
   "scrypted": {
      "name": "Kibble Feeder",
      "type": "API",
      "interfaces": [
         "MixinProvider",
         "Settings"
      ]
   },
   "dependencies": {
      "@scrypted/sdk": "^0.5.59"
   },
   "devDependencies": {
      "@types/node": "^22.0.0",
      "terser-webpack-plugin": "^5.6.1",
      "typescript": "^5.9.0"
   }
}
